# Set these in Vercel → Project → Settings → Environment Variables (never commit real values).

# Field Notes subscriber storage (Upstash Redis, REST).
# Added automatically when an Upstash Redis database is connected via Vercel Storage / Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Alternative names if you create the Upstash database yourself:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Field Records — must be an https://www.instagram.com/<account>/ URL. Leave empty to keep the button disabled.
INSTAGRAM_URL=
