# Set these in Vercel → Project → Settings → Environment Variables (never commit real values).

# Field Notes subscriber storage — Neon PostgreSQL connection string.
# Use the *pooled* connection string from Neon (host contains "-pooler"), e.g.
# postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
DATABASE_URL=

# Confirmation email via Resend (domain utaki.me must be verified in Resend).
RESEND_API_KEY=
# Optional. Sender on utaki.me; defaults to "TIME WILL TELL <field-notes@utaki.me>".
RESEND_FROM=
# Optional. Public site origin used for links in emails, e.g. https://utaki.me (defaults to the request host).
SITE_URL=

# Field Records — must be an https://www.instagram.com/<account>/ URL. Leave empty to keep the button disabled.
INSTAGRAM_URL=
